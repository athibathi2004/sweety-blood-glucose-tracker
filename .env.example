# ==============================================================================
# Sweety Application Environment Configuration Template
# Copy this file to `server/.env` and update the values for your environment.
# DO NOT commit real secrets to version control.
# ==============================================================================

# Server Network & Runtime Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://sweety_app:REPLACE_WITH_YOUR_PASSWORD@localhost:5432/sweety_db?schema=public"

# JWT Authentication
# Use a strong, cryptographically secure random string (at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12
